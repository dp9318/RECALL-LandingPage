# ==============================================================================
# RECALL Marketing Website & Protected Download Portal — Environment Template
# ==============================================================================
# Copy this file to .env.local for local development.
# DO NOT commit real secrets, tokens, or .env.local to version control.
# Production and Preview secrets must be configured within the Vercel dashboard.

# ------------------------------------------------------------------------------
# 1. Canonical Site URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Website Identity & Private Storage only)
# Note: RECALL's local engine does NOT upload local memories to Supabase.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only Supabase Service Secret (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=your-supabase-server-secret-key

# ------------------------------------------------------------------------------
# 3. Release Artifact & Gate Configuration (Server-Only)
# ------------------------------------------------------------------------------
SUPABASE_RELEASE_BUCKET=recall-releases
SUPABASE_RELEASE_OBJECT_PATH=recall-windows.zip
CURRENT_RELEASE_VERSION=2.1.1

# ------------------------------------------------------------------------------
# 4. Rate Limiting — Upstash Redis (Server-Only)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# ------------------------------------------------------------------------------
# 5. Optional Services (Enable only when configured and tested)
# ------------------------------------------------------------------------------
# Cloudflare Turnstile bot verification
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Error monitoring
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
